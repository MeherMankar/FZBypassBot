# Copy this file to config.env in the repo root and fill in the values.
# Any value left empty here is read from the environment instead.
# Keys set in the environment take priority over this file.

# ── Required ──────────────────────────────────────────────────────────────────
BOT_TOKEN=
API_HASH=
API_ID=
OWNER_ID=0

# ── Authorization ─────────────────────────────────────────────────────────────
# Chats / topics where the bypass command or AUTO_BYPASS is active.
# Space-separated. Use chat_id:topic_id for forum topics.
# Format: -100xxxxxxxxxx -100xxxxxxxxxx:12 -100xxxxxxxxxx
AUTH_CHATS=

# Channel IDs where the bot auto-edits posts in-place with bypassed links.
# Bot must be admin with "Edit Messages" permission.
# Space-separated. Format: -100xxxxxxxxxx -100xxxxxxxxxx
AUTH_CHANNELS=

# ── Behaviour ─────────────────────────────────────────────────────────────────
# true  → bypass every URL automatically without a command
# false → only bypass when /bypass command is used (default)
AUTO_BYPASS=false

# Suffix appended to every bot command. Example: "1" makes /bypass → /bypass1
CMD_SUFFIX=

# ── Terabox ───────────────────────────────────────────────────────────────────
# Recommended: URL of your deployed grabx-api instance (new unified API).
# Supports Terabox, PornHub, and more. Deploy: https://github.com/MeherMankar/grabx-api
GRABX_API_URL=

# API key for grabx-api (set API_KEY env var on the server to enable auth).
GRABX_API_KEY=

# Legacy: URL of the old terabox-downloader-api instance (fallback if GRABX_API_URL unset).
TERABOX_API_URL=

# Fallback: ndus cookie from your Terabox browser session.
# Used only when TERABOX_API_URL is unset or unreachable.
# Get via DevTools → Application → Cookies → ndus
TERA_COOKIE=

# ── GDrive / DDL sites ────────────────────────────────────────────────────────
GDTOT_CRYPT=
HUBDRIVE_CRYPT=
DRIVEFIRE_CRYPT=
KATDRIVE_CRYPT=
LARAVEL_SESSION=
XSRF_TOKEN=

# GDrive direct-download index (optional).
# Generate via Cloudflare Workers: https://gitlab.com/GoogleDriveIndex/cloudflare-gdrive-download-worker
DIRECT_INDEX=

# ── Deployment ────────────────────────────────────────────────────────────────
# Health-check server port. Render / Koyeb set $PORT automatically.
PORT=8080

# ── link-bypass-api ───────────────────────────────────────────────────────────
# URL of your deployed link-bypass-api instance (Puppeteer/Chromium microservice).
# When set, vplink.in links are resolved via this API first.
# The pure-HTTP Chrome-fingerprint fallback is used when the API is unreachable.
# Deploy: https://github.com/MeherMankar/link-bypass-api
# POST /bypass  body: {"url": "https://vplink.in/CODE"}  → {"status":"ok","result":"<dest>"}
BYPASS_API_URL=

# ── Turnstile shorteners ──────────────────────────────────────────────────────
# Peak.fo API key — required to bypass Turnstile-protected shorteners
# (srnky.com, clksz.com, oii.la and any other shrinkearn.com / clk.sh domains).
# Free tier: 1,000 solves. Get key at https://peak.fo
PEAK_API_KEY=

# ── Webshare Proxy API ────────────────────────────────────────────────────────
# Automatically fetch and rotate proxies directly from Webshare.io.
# Supports multiple API keys (api1, api2, api3, api4, ...).
# The bot randomly selects an API key, then randomly selects a proxy from it.
# You can provide a comma-separated list of keys:
#   WEBSHARE_API_KEY=key1,key2,key3,key4
#   WEBSHARE_API_KEYS=key1,key2,key3,key4
# Or individual numbered variables:
#   WEBSHARE_API_KEY_1=key1
#   WEBSHARE_API_KEY_2=key2
#   WEBSHARE_API_KEY_3=key3
WEBSHARE_API_KEY=
WEBSHARE_API_KEYS=

# Webshare proxy mode: "direct" (default, direct IP:port) or "backbone"
WEBSHARE_MODE=direct

# Cache refresh interval in seconds (default: 1800, i.e. 30 minutes)
WEBSHARE_REFRESH_INTERVAL=1800

# ── Manual Proxy (Fallback) ───────────────────────────────────────────────────
# HTTP/SOCKS5 proxy list if not using Webshare, or as fallback.
# Format: host:port:user:pass or http://user:pass@host:port (comma-separated).
# Leave empty to use the server's own IP (default).
PROXY_URL=

# ── Auto-update ───────────────────────────────────────────────────────────────
# Set to your own fork so /restart pulls your changes, not the upstream repo.
UPSTREAM_REPO=https://github.com/MeherMankar/FZBypassBot
UPSTREAM_BRANCH=main
